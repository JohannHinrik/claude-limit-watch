{
  "permissions": {
    "allow": ["CronCreate", "CronList", "CronDelete"]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/limit-statusline.mjs",
    "refreshInterval": 60
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task|Workflow)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/limit-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/limit-watch.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/limit-watch.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
